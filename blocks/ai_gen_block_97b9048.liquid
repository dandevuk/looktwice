{% doc %}
  @prompt
    Add custom CSS to make a specific navigation menu item with the text "SALE" display in red colour, while leaving all other menu items unchanged.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-nav-css-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-custom-nav-css-{{ ai_gen_id }} a:has(span:only-child) span {
    color: inherit;
  }

  .ai-custom-nav-css-{{ ai_gen_id }} a:has(span:only-child:is([data-text="{{ block.settings.menu_item_text }}"])) span {
    color: {{ block.settings.text_color }} !important;
  }
{% endstyle %}

<div class="ai-custom-nav-css-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <style>
    {% if block.settings.menu_item_text != blank %}
      header a:has(span:only-child:is([data-text="{{ block.settings.menu_item_text }}"])) span,
      nav a:has(span:only-child:is([data-text="{{ block.settings.menu_item_text }}"])) span {
        color: {{ block.settings.text_color }} !important;
      }
    {% endif %}
  </style>
</div>

<script>
  (function() {
    class CustomNavCSS{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.applyDataAttributes();
      }

      applyDataAttributes() {
        const targetText = {{ block.settings.menu_item_text | json }};
        if (!targetText) return;

        const navLinks = document.querySelectorAll('header a span, nav a span');
        navLinks.forEach((span) => {
          const text = span.textContent.trim();
          span.setAttribute('data-text', text);
        });
      }
    }

    if (!customElements.get('custom-nav-css-{{ ai_gen_id }}')) {
      customElements.define('custom-nav-css-{{ ai_gen_id }}', CustomNavCSS{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Custom navigation CSS",
  "settings": [
    {
      "type": "text",
      "id": "menu_item_text",
      "label": "Menu item text",
      "default": "SALE",
      "info": "Enter the exact text of the menu item to style (case-sensitive)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ff0000"
    }
  ],
  "presets": [
    {
      "name": "Custom navigation CSS"
    }
  ]
}
{% endschema %}
