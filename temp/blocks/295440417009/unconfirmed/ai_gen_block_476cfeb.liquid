{% doc %}
  @prompt
    When a product has multiple variants with different prices, display "From £X" (using the lowest variant price) instead of a single price on product cards and product pages. The "From" prefix should only appear when variant prices differ — if all variants are the same price, show the price as normal.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign min_price = product.price_min
  assign max_price = product.price_max
  assign has_price_range = false
  
  if min_price != max_price
    assign has_price_range = true
  endif
%}

{% style %}
  .ai-price-display-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-price-display__wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: baseline;
    gap: {{ block.settings.spacing }}px;
    flex-wrap: wrap;
  }

  .ai-price-display__from-{{ ai_gen_id }} {
    font-size: {{ block.settings.from_text_size }}px;
    color: {{ block.settings.from_text_color }};
    font-weight: {{ block.settings.from_text_weight }};
  }

  .ai-price-display__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: {{ block.settings.price_weight }};
  }

  .ai-price-display__compare-{{ ai_gen_id }} {
    font-size: {{ block.settings.compare_size }}px;
    color: {{ block.settings.compare_color }};
    text-decoration: line-through;
    opacity: 0.7;
  }

  .ai-price-display__sale-badge-{{ ai_gen_id }} {
    display: inline-block;
    padding: 4px 8px;
    background-color: {{ block.settings.sale_badge_bg }};
    color: {{ block.settings.sale_badge_text_color }};
    font-size: {{ block.settings.sale_badge_size }}px;
    border-radius: {{ block.settings.sale_badge_radius }}px;
    font-weight: 600;
  }
{% endstyle %}

<div class="ai-price-display-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-price-display__wrapper-{{ ai_gen_id }}">
    {% if has_price_range %}
      <span class="ai-price-display__from-{{ ai_gen_id }}">{{ block.settings.from_text }}</span>
    {% endif %}

    <span class="ai-price-display__price-{{ ai_gen_id }}">
      {{ min_price | money }}
    </span>

    {% if product.compare_at_price_min > min_price and block.settings.show_compare_price %}
      <span class="ai-price-display__compare-{{ ai_gen_id }}">
        {{ product.compare_at_price_min | money }}
      </span>
    {% endif %}

    {% if product.compare_at_price_min > min_price and block.settings.show_sale_badge %}
      <span class="ai-price-display__sale-badge-{{ ai_gen_id }}">
        {{ block.settings.sale_badge_label }}
      </span>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product price display",
  "settings": [
    {
      "type": "header",
      "content": "From text"
    },
    {
      "type": "text",
      "id": "from_text",
      "label": "From prefix",
      "default": "From"
    },
    {
      "type": "range",
      "id": "from_text_size",
      "label": "From text size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "from_text_color",
      "label": "From text color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "from_text_weight",
      "label": "From text weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Price size",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "price_weight",
      "label": "Price weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Spacing between elements",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Compare at price"
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show compare at price",
      "default": true
    },
    {
      "type": "range",
      "id": "compare_size",
      "label": "Compare price size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "compare_color",
      "label": "Compare price color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Sale badge"
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Show sale badge",
      "default": false
    },
    {
      "type": "text",
      "id": "sale_badge_label",
      "label": "Sale badge text",
      "default": "Sale"
    },
    {
      "type": "range",
      "id": "sale_badge_size",
      "label": "Badge text size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "sale_badge_bg",
      "label": "Badge background",
      "default": "#f9e90b"
    },
    {
      "type": "color",
      "id": "sale_badge_text_color",
      "label": "Badge text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "sale_badge_radius",
      "label": "Badge border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Product price display"
    }
  ]
}
{% endschema %}
