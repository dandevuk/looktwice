{% doc %}
  @prompt
    Create a promotional discount offer popup that appears after a short delay when a visitor lands on the page. The popup should include a headline, a short promotional message, a discount code displayed prominently, and a call-to-action button. It should have a close button, be visually styled to match a premium lifestyle brand with clean minimal design, and not show again once dismissed (using localStorage). All text and the discount code should be customizable via theme editor settings.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-popup-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .ai-promo-popup-{{ ai_gen_id }}.active {
    display: flex;
  }

  .ai-promo-popup-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
  }

  .ai-promo-popup-content-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.popup_background }};
    border-radius: {{ block.settings.border_radius }}px;
    max-width: {{ block.settings.popup_width }}px;
    width: 100%;
    padding: {{ block.settings.padding }}px;
    text-align: center;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    opacity: 0;
    transform: scale(0.9);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-promo-popup-{{ ai_gen_id }}.active .ai-promo-popup-content-{{ ai_gen_id }} {
    opacity: 1;
    transform: scale(1);
  }

  .ai-promo-popup-close-{{ ai_gen_id }} {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    transition: opacity 0.2s ease;
    line-height: 1;
  }

  .ai-promo-popup-close-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-promo-popup-close-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  .ai-promo-popup-headline-{{ ai_gen_id }} {
    color: {{ block.settings.headline_color }};
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-promo-popup-message-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    margin: 0 0 24px;
  }

  .ai-promo-popup-code-wrapper-{{ ai_gen_id }} {
    background-color: {{ block.settings.code_background }};
    border: {{ block.settings.code_border_width }}px {{ block.settings.code_border_style }} {{ block.settings.code_border_color }};
    border-radius: {{ block.settings.code_border_radius }}px;
    padding: 16px 24px;
    margin: 0 0 24px;
  }

  .ai-promo-popup-code-label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 8px;
    opacity: 0.7;
  }

  .ai-promo-popup-code-{{ ai_gen_id }} {
    color: {{ block.settings.code_text_color }};
    font-size: {{ block.settings.code_size }}px;
    font-weight: 700;
    letter-spacing: 2px;
    margin: 0;
    font-family: monospace;
  }

  .ai-promo-popup-button-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    padding: 14px 32px;
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .ai-promo-popup-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-1px);
  }

  @media screen and (max-width: 749px) {
    .ai-promo-popup-content-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.7 }}px;
    }

    .ai-promo-popup-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.8 }}px;
    }

    .ai-promo-popup-code-{{ ai_gen_id }} {
      font-size: {{ block.settings.code_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<promo-popup-{{ ai_gen_id }}
  class="ai-promo-popup-{{ ai_gen_id }}"
  data-delay="{{ block.settings.delay }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-promo-popup-overlay-{{ ai_gen_id }}"></div>
  <div class="ai-promo-popup-content-{{ ai_gen_id }}">
    <button
      class="ai-promo-popup-close-{{ ai_gen_id }}"
      aria-label="Close popup"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    {% if block.settings.headline != blank %}
      <h2 class="ai-promo-popup-headline-{{ ai_gen_id }}">
        {{ block.settings.headline }}
      </h2>
    {% endif %}

    {% if block.settings.message != blank %}
      <div class="ai-promo-popup-message-{{ ai_gen_id }}">
        {{ block.settings.message }}
      </div>
    {% endif %}

    {% if block.settings.discount_code != blank %}
      <div class="ai-promo-popup-code-wrapper-{{ ai_gen_id }}">
        {% if block.settings.code_label != blank %}
          <p class="ai-promo-popup-code-label-{{ ai_gen_id }}">
            {{ block.settings.code_label }}
          </p>
        {% endif %}
        <p class="ai-promo-popup-code-{{ ai_gen_id }}">
          {{ block.settings.discount_code }}
        </p>
      </div>
    {% endif %}

    {% if block.settings.button_text != blank %}
      <a
        href="{{ block.settings.button_link }}"
        class="ai-promo-popup-button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</promo-popup-{{ ai_gen_id }}>

<script>
  (function() {
    class PromoPopup{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.storageKey = 'ai-promo-popup-dismissed-{{ ai_gen_id }}';
      }

      connectedCallback() {
        if (this.hasBeenDismissed()) {
          return;
        }

        const delay = parseInt(this.dataset.delay) || 2000;
        
        setTimeout(() => {
          this.showPopup();
        }, delay);

        this.setupEventListeners();
      }

      hasBeenDismissed() {
        try {
          return localStorage.getItem(this.storageKey) === 'true';
        } catch (e) {
          return false;
        }
      }

      showPopup() {
        this.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      hidePopup() {
        this.classList.remove('active');
        document.body.style.overflow = '';
        this.markAsDismissed();
      }

      markAsDismissed() {
        try {
          localStorage.setItem(this.storageKey, 'true');
        } catch (e) {
          console.warn('localStorage not available');
        }
      }

      setupEventListeners() {
        const closeButton = this.querySelector('.ai-promo-popup-close-{{ ai_gen_id }}');
        const overlay = this.querySelector('.ai-promo-popup-overlay-{{ ai_gen_id }}');
        const ctaButton = this.querySelector('.ai-promo-popup-button-{{ ai_gen_id }}');

        if (closeButton) {
          closeButton.addEventListener('click', () => {
            this.hidePopup();
          });
        }

        if (overlay) {
          overlay.addEventListener('click', () => {
            this.hidePopup();
          });
        }

        if (ctaButton) {
          ctaButton.addEventListener('click', () => {
            this.markAsDismissed();
          });
        }

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.classList.contains('active')) {
            this.hidePopup();
          }
        });
      }
    }

    customElements.define('promo-popup-{{ ai_gen_id }}', PromoPopup{{ ai_gen_id }});
  })();
</script>

